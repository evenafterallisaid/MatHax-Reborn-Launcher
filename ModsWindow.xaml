<Window x:Class="MatHax.Reborn.Launcher.ModsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MatHax Reborn Mods" Width="720" Height="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="Transparent" AllowsTransparency="True" UseLayoutRounding="True"
        SnapsToDevicePixels="True" SizeChanged="Window_SizeChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="7" CornerRadius="16" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="16"
            BorderBrush="#2A2032" BorderThickness="1">
        <Border.Clip>
            <RectangleGeometry x:Name="ShellClip" RadiusX="16" RadiusY="16" />
        </Border.Clip>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="COMPATIBLE MODS" Margin="18,0" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                <Button Width="46" Height="46" HorizontalAlignment="Right" Content="×" FontSize="20"
                        Foreground="{StaticResource MutedBrush}" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="28,18,28,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Mods that play nicely with MatHax" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Curated for Minecraft 26.2 • downloaded from Modrinth • SHA-512 verified"
                               Margin="0,7,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,20,0,14">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="11" Padding="18,14" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Sodium" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Rendering optimization for smoother frame rates." Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="SodiumVersion" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MintBrush}" />
                            </StackPanel>
                            <Button x:Name="SodiumButton" Content="Install" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Padding="20,10" Click="Sodium_Click" />
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="11" Padding="18,14" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Lithium" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Game-logic and tick-performance optimization." Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="LithiumVersion" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MintBrush}" />
                            </StackPanel>
                            <Button x:Name="LithiumButton" Content="Install" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Padding="20,10" Click="Lithium_Click" />
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="11" Padding="18,14">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Iris" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Shader-pack support; Sodium is installed automatically." Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="IrisVersion" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource MintBrush}" />
                            </StackPanel>
                            <Button x:Name="IrisButton" Content="Install" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Padding="20,10" Click="Iris_Click" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="StatusText" Text="Mods are installed into the direct-launch MatHax instance."
                               FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <ProgressBar x:Name="Progress" Height="4" Margin="0,10,0,0" Minimum="0" Maximum="100"
                                 Foreground="{StaticResource AccentBrush}" Background="#2A2032" BorderThickness="0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
